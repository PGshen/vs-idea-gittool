    "viewsContainers": {
      "activitybar": [
        {
          "id": "rebased",
          "title": "Rebased",
          "icon": "media/activity/commit.svg"
        }
      ],
      "panel": [
        {
          "id": "rebased-panel",
          "title": "Git",
          "icon": "media/activity/vcs.svg"
        }
      ]
    },
    "views": {
      "rebased": [
        {
          "type": "webview",
          "id": "rebased.commit",
          "name": "Commit",
          "icon": "media/activity/commit.svg",
          "contextualTitle": "Commit"
        }
      ],
      "rebased-panel": [
        {
          "type": "webview",
          "id": "rebased.logView",
          "name": "Log",
          "when": "rebased.logInPanel"
        },
        {
          "id": "rebased.worktrees",
          "name": "Worktrees",
          "when": "rebased.hasRepository"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "rebased.git.file",
          "group": "7_modification@9",
          "when": "rebased.hasRepository"
        }
      ],
      "editor/context": [
        {
          "submenu": "rebased.git.file",
          "group": "1_modification@9",
          "when": "rebased.hasRepository && resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "rebased.git.file",
          "group": "2_files@9",
          "when": "rebased.hasRepository && resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "rebased.addToVcs",
          "when": "rebased.hasRepository"
        },
        {
          "command": "rebased.addToGitignore",
          "when": "rebased.hasRepository"
        },
        {
          "command": "rebased.log.selectCommit",
          "when": "false"
        },
        {
          "command": "rebased.annotateRevision",
          "when": "false"
        },
