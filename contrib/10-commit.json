{
  "views": {
    "ideagittool": [
      {
        "type": "webview",
        "id": "ideagittool.commit",
        "name": "Commit",
        "icon": "media/activity/ideagittool.svg",
        "contextualTitle": "Commit"
      }
    ]
  },
  "commands": [
    {
      "command": "ideagittool.commit",
      "title": "Commit\u2026",
      "category": "IdeaGitTool",
      "icon": "$(git-commit)"
    },
    {
      "command": "ideagittool.commitAndPush",
      "title": "Commit and Push\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.resolveConflicts",
      "title": "Resolve Conflicts\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.refreshChanges",
      "title": "Refresh",
      "category": "IdeaGitTool",
      "icon": "$(refresh)"
    },
    {
      "command": "ideagittool.rollback",
      "title": "Rollback\u2026",
      "category": "IdeaGitTool",
      "icon": "$(discard)"
    },
    {
      "command": "ideagittool.addToVcs",
      "title": "Add to VCS",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.addToGitignore",
      "title": "Add to .gitignore",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showLocalDiff",
      "title": "Compare with Same Repository Version",
      "category": "IdeaGitTool",
      "icon": "$(diff)"
    },
    {
      "command": "ideagittool.shelve",
      "title": "Shelve Changes\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.shelveSilently",
      "title": "Shelve Silently",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.unshelve",
      "title": "Unshelve\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showShelf",
      "title": "Show Shelf",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showStashes",
      "title": "Show Stashes",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.stash",
      "title": "Stash Changes\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.unstash",
      "title": "Unstash Changes\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.newChangelist",
      "title": "New Changelist\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.importPatches",
      "title": "Import Patches\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.resolveConflictsInFile",
      "title": "Resolve Conflicts\u2026 (IdeaGitTool)",
      "category": "IdeaGitTool",
      "icon": {
        "light": "media/icons/vcs/merge.svg",
        "dark": "media/icons/vcs/merge_dark.svg"
      }
    },
    {
      "command": "ideagittool.merge.useIdeaGitToolForConflicts",
      "title": "Use IdeaGitTool for Merge Conflicts",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.merge.restoreVsCodeConflictUi",
      "title": "Restore VS Code's Built-in Merge Conflict UI",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.ai.generateCommitMessage",
      "title": "Generate Commit Message with AI",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.ai.setApiKey",
      "title": "Set API Key for AI Commit Messages…",
      "category": "IdeaGitTool"
    }
  ],
  "menus": {
    "view/title": [
      {
        "command": "ideagittool.showLog",
        "when": "view == ideagittool.commit",
        "group": "navigation@1"
      },
      {
        "command": "ideagittool.showConsole",
        "when": "view == ideagittool.commit",
        "group": "navigation@2"
      }
    ],
    "explorer/context": [],
    "editor/context": [],
    "editor/title/context": [],
    "commandPalette": [
      {
        "command": "ideagittool.addToVcs",
        "when": "ideagittool.hasRepository"
      },
      {
        "command": "ideagittool.addToGitignore",
        "when": "ideagittool.hasRepository"
      },
      {
        "command": "ideagittool.ai.generateCommitMessage",
        "when": "ideagittool.hasRepository"
      },
      {
        "command": "ideagittool.resolveConflictsInFile",
        "when": "resourceScheme == file && resource in ideagittool.conflictedFiles"
      }
    ],
    "editor/title": [
      {
        "command": "ideagittool.resolveConflictsInFile",
        "group": "navigation@-10",
        "when": "resourceScheme == file && resource in ideagittool.conflictedFiles && !isInDiffEditor && !isMergeEditor"
      }
    ]
  },
  "keybindings": [
    {
      "command": "ideagittool.commit",
      "key": "ctrl+k",
      "mac": "cmd+k",
      "when": "focusedView == ideagittool.commit"
    },
    {
      "command": "ideagittool.commit",
      "key": "ctrl+k",
      "mac": "cmd+k",
      "when": "config.ideagittool.intellijShortcuts && config.ideagittool.intellijShortcutsInEditor"
    },
    {
      "command": "ideagittool.commitAndPush",
      "key": "ctrl+alt+k",
      "mac": "alt+cmd+k",
      "when": "config.ideagittool.intellijShortcuts"
    },
    {
      "command": "ideagittool.rollback",
      "key": "ctrl+alt+z",
      "mac": "alt+cmd+z",
      "when": "config.ideagittool.intellijShortcuts && !editorTextFocus && focusedView != ideagittool.commit"
    },
    {
      "command": "ideagittool.unshelve",
      "key": "ctrl+shift+u",
      "when": "focusedView == ideagittool.commit"
    }
  ],
  "colors": [
    {
      "id": "ideagittool.fileStatus.modified",
      "description": "Modified file (IntelliJ FILESTATUS_MODIFIED)",
      "defaults": {
        "dark": "#70AEFF",
        "light": "#0033B3",
        "highContrast": "#70AEFF",
        "highContrastLight": "#0033B3"
      }
    },
    {
      "id": "ideagittool.fileStatus.added",
      "description": "Added file (FILESTATUS_ADDED)",
      "defaults": {
        "dark": "#73BD79",
        "light": "#067D17",
        "highContrast": "#73BD79",
        "highContrastLight": "#067D17"
      }
    },
    {
      "id": "ideagittool.fileStatus.deleted",
      "description": "Deleted file (FILESTATUS_DELETED)",
      "defaults": {
        "dark": "#6F737A",
        "light": "#6C707E",
        "highContrast": "#6F737A",
        "highContrastLight": "#6C707E"
      }
    },
    {
      "id": "ideagittool.fileStatus.unknown",
      "description": "Unversioned file (FILESTATUS_UNKNOWN)",
      "defaults": {
        "dark": "#E88F89",
        "light": "#B23247",
        "highContrast": "#E88F89",
        "highContrastLight": "#B23247"
      }
    },
    {
      "id": "ideagittool.fileStatus.ignored",
      "description": "Ignored file (FILESTATUS_IDEA_FILESTATUS_IGNORED)",
      "defaults": {
        "dark": "#D69A6B",
        "light": "#8C4F00",
        "highContrast": "#D69A6B",
        "highContrastLight": "#8C4F00"
      }
    },
    {
      "id": "ideagittool.fileStatus.conflict",
      "description": "File with merge conflicts (FILESTATUS_MERGED_WITH_CONFLICTS)",
      "defaults": {
        "dark": "#DE6A66",
        "light": "#DE1B2E",
        "highContrast": "#DE6A66",
        "highContrastLight": "#DE1B2E"
      }
    }
  ],
  "configuration": {
    "properties": {
      "ideagittool.fileStatusColors": {
        "type": "boolean",
        "default": true,
        "description": "Color file names in the Explorer and editor tabs by their Git status, like IntelliJ."
      },
      "ideagittool.commit.gpgSign": {
        "type": "boolean",
        "default": false,
        "description": "Sign commits with GPG key (git commit -S). Like IntelliJ, this is a setting, not a commit option."
      },
      "ideagittool.commit.includeActiveChangelist": {
        "type": "boolean",
        "default": false,
        "description": "Include new changes of the active changelist into the commit automatically (check them in the Commit tool window)."
      },
      "ideagittool.commit.skipHooks": {
        "type": "boolean",
        "default": false,
        "description": "Do not run Git commit hooks (commit always runs with '--no-verify')."
      },
      "ideagittool.ai.provider": {
        "type": "string",
        "enum": ["openai", "anthropic"],
        "enumDescriptions": [
          "OpenAI-compatible chat completions: OpenAI, DeepSeek, Kimi, Qwen, Ollama (http://localhost:11434/v1), LM Studio, internal gateways.",
          "Anthropic Messages API (Claude)."
        ],
        "default": "openai",
        "description": "The provider of the AI that generates commit messages (the sparkle button in the Commit tool window)."
      },
      "ideagittool.ai.baseUrl": {
        "type": "string",
        "default": "",
        "markdownDescription": "Base URL of the AI provider, replacing its official endpoint: everything up to (excluding) `chat/completions` (openai) or `v1/messages` (anthropic). Examples: `https://api.deepseek.com/v1`, `http://localhost:11434/v1` (Ollama). Empty uses the official endpoint."
      },
      "ideagittool.ai.model": {
        "type": "string",
        "default": "",
        "markdownDescription": "The model asked to generate commit messages, e.g. `deepseek-chat`, `gpt-4o-mini`, `claude-haiku-5-5`, or an Ollama model name. The AI button warns when this is empty."
      },
      "ideagittool.ai.language": {
        "type": "string",
        "default": "",
        "markdownDescription": "The language of AI-generated commit messages, as a word the model understands — e.g. `English`, `简体中文`, `日本語`, `Deutsch`. Empty follows VS Code's display language."
      },
      "ideagittool.ai.prompt": {
        "type": "string",
        "default": "",
        "markdownDescription": "Replaces the built-in instructions for AI-generated commit messages (`{language}` is filled in). The changed files and the diff are always appended after the instructions."
      },
      "ideagittool.ai.maxDiffChars": {
        "type": "number",
        "default": 8000,
        "description": "The diff sent to the AI is truncated beyond this many characters per repository (the prompt notes '...[diff truncated]'). 0 disables the limit."
      },
      "ideagittool.intellijShortcuts": {
        "type": "boolean",
        "default": true,
        "description": "Enable IntelliJ keyboard shortcuts that do not conflict with common VS Code chords (Ctrl+Alt+K Commit and Push, Ctrl+Alt+Z Rollback)."
      },
      "ideagittool.merge.useVsCodeMergeEditor": {
        "type": "boolean",
        "default": false,
        "description": "Resolve Manually\u2026 opens VS Code's merge editor instead of the IntelliJ-style three-pane merge window."
      },
      "ideagittool.merge.handleConflicts": {
        "type": "string",
        "enum": ["ask", "always", "never"],
        "enumDescriptions": [
          "Ask once per workspace, when the first conflict appears.",
          "Resolve conflicts with IdeaGitTool: turn off VS Code's merge conflict CodeLens and decorations (merge-conflict.codeLens.enabled, merge-conflict.decorators.enabled) and the automatic merge editor (git.mergeEditor). Run \"Restore VS Code's Built-in Merge Conflict UI\" to undo.",
          "Keep VS Code's built-in conflict UI as it is; IdeaGitTool never changes those settings."
        ],
        "default": "ask",
        "markdownDescription": "Whether IdeaGitTool handles merge conflicts in the editor instead of VS Code's built-in conflict UI. IdeaGitTool changes VS Code's settings only after you agree (or choose `always` here)."
      },
      "ideagittool.merge.contextLines": {
        "type": "number",
        "enum": [1, 2, 4, 8, -1],
        "enumDescriptions": ["1 line", "2 lines", "4 lines", "8 lines", "Do not collapse"],
        "default": 4,
        "description": "Diff & Merge: the number of unchanged lines kept around changes by Collapse Unchanged Fragments in the merge window."
      }
    }
  }
}
