{
  "configuration": {
    "properties": {
      "ideagittool.log.showInEditor": {
        "type": "boolean",
        "default": false,
        "description": "Show the log in the editor window, like Rebased. When off (the default), the log is shown in the \"Git\" panel at the bottom, like in JetBrains IDEs."
      },
      "ideagittool.log.openOnStartup": {
        "type": "boolean",
        "default": true,
        "description": "Show the Git log when a workspace with a Git repository is opened (in the \"Git\" panel, or in the editor with ideagittool.log.showInEditor)."
      },
      "ideagittool.annotate.showAuthor": {
        "type": "boolean",
        "default": true,
        "description": "Annotate with Git Blame: show the author."
      },
      "ideagittool.annotate.showDate": {
        "type": "boolean",
        "default": true,
        "description": "Annotate with Git Blame: show the date."
      },
      "ideagittool.annotate.showRevision": {
        "type": "boolean",
        "default": false,
        "description": "Annotate with Git Blame: show the revision."
      },
      "ideagittool.annotate.preferCommitDate": {
        "type": "boolean",
        "default": false,
        "description": "Annotate with Git Blame: show the commit timestamp instead of the author timestamp."
      },
      "ideagittool.annotate.names": {
        "type": "string",
        "enum": [
          "full",
          "first",
          "last",
          "initials",
          "email"
        ],
        "default": "first",
        "description": "Annotate with Git Blame: how to show author names."
      },
      "ideagittool.annotate.colors": {
        "type": "string",
        "enum": [
          "order",
          "author",
          "hide"
        ],
        "default": "order",
        "description": "Annotate with Git Blame: background colors by commit order (age), by author, or none."
      },
      "ideagittool.annotate.ignoreWhitespace": {
        "type": "boolean",
        "default": false,
        "description": "Annotate with Git Blame: ignore whitespace changes (-w)."
      },
      "ideagittool.annotate.detectMovementsWithinFile": {
        "type": "boolean",
        "default": false,
        "description": "Annotate with Git Blame: detect moved lines within the file (-M)."
      },
      "ideagittool.annotate.detectMovementsAcrossFiles": {
        "type": "boolean",
        "default": false,
        "description": "Annotate with Git Blame: detect lines moved from other files (-C)."
      }
    }
  },
  "commands": [
    {
      "command": "ideagittool.showLog",
      "title": "Show Git Log",
      "category": "IdeaGitTool",
      "icon": "$(git-commit)"
    },
    {
      "command": "ideagittool.log.newTab",
      "title": "Open New Git Log Tab",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.log.selectCommit",
      "title": "Show in Git Log",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showFileHistory",
      "title": "Show History",
      "category": "IdeaGitTool",
      "icon": "$(history)"
    },
    {
      "command": "ideagittool.showHistoryForSelection",
      "title": "Show History for Selection",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.annotate",
      "title": "Annotate with Git Blame",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.annotateClose",
      "title": "Close Annotations",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.annotateOptions",
      "title": "Annotations View Options",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.annotateRevision",
      "title": "Annotate Revision",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.compareWithRevision",
      "title": "Compare with Revision\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.compareWithBranch",
      "title": "Compare with Branch or Tag\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.compareRefs",
      "title": "Compare with Branch\u2026",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.compareRefs.files",
      "title": "Show Files Diff",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showCommitDiff",
      "title": "Show Commit Diff",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.showRepositoryAtRevision",
      "title": "Show Repository at Revision",
      "category": "IdeaGitTool"
    },
    {
      "command": "ideagittool.copyText",
      "title": "Copy",
      "category": "IdeaGitTool"
    }
  ],
  "views": {
    "ideagittool-panel": [
      {
        "type": "webview",
        "id": "ideagittool.logView",
        "name": "Log",
        "when": "ideagittool.logInPanel"
      }
    ]
  },
  "menus": {
    "commandPalette": [
      {
        "command": "ideagittool.log.selectCommit",
        "when": "false"
      },
      {
        "command": "ideagittool.annotateRevision",
        "when": "false"
      },
      {
        "command": "ideagittool.compareRefs.files",
        "when": "false"
      },
      {
        "command": "ideagittool.showCommitDiff",
        "when": "false"
      },
      {
        "command": "ideagittool.showRepositoryAtRevision",
        "when": "false"
      },
      {
        "command": "ideagittool.copyText",
        "when": "false"
      },
      {
        "command": "ideagittool.annotate",
        "when": "ideagittool.hasRepository && editorIsOpen && !ideagittool.annotated"
      },
      {
        "command": "ideagittool.annotateClose",
        "when": "ideagittool.annotated"
      },
      {
        "command": "ideagittool.showHistoryForSelection",
        "when": "editorHasSelection"
      }
    ],
    "editor/context": [],
    "explorer/context": [],
    "editor/title/context": [],
    "editor/lineNumber/context": [
      {
        "command": "ideagittool.annotate",
        "when": "ideagittool.hasRepository && !ideagittool.annotated",
        "group": "9_ideagittool"
      },
      {
        "command": "ideagittool.annotateClose",
        "when": "ideagittool.annotated",
        "group": "9_ideagittool"
      },
      {
        "command": "ideagittool.annotateOptions",
        "when": "ideagittool.annotated",
        "group": "9_ideagittool"
      }
    ]
  },
  "keybindings": [
    {
      "command": "ideagittool.showLog",
      "key": "alt+9",
      "mac": "cmd+9",
      "when": "ideagittool.hasRepository"
    },
    {
      "command": "ideagittool.annotate",
      "key": "ctrl+alt+shift+a",
      "when": "editorTextFocus && ideagittool.hasRepository && !ideagittool.annotated"
    },
    {
      "command": "ideagittool.annotateClose",
      "key": "ctrl+alt+shift+a",
      "when": "editorTextFocus && ideagittool.annotated"
    }
  ]
}
