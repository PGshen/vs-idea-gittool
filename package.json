      "panel": [
        {
          "id": "rebased-panel",
          "title": "Git",
          "icon": "media/activity/vcs.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "rebased.branch.checkout",
          "when": "false"
        },
        {
          "command": "rebased.branch.newBranchFrom",
          "when": "false"
        },
        {
