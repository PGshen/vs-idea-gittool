    "view/title": [
      {
        "command": "ideagittool.worktrees.create",
        "when": "view == ideagittool.worktrees",
        "group": "navigation@1"
      },
      {
        "command": "ideagittool.worktrees.refresh",
        "when": "view == ideagittool.worktrees",
        "group": "navigation@2"
      },
      {
        "command": "ideagittool.worktrees.delete",
        "when": "view == ideagittool.worktrees",
        "group": "navigation@3"
      },
      {
        "command": "ideagittool.worktrees.prune",
        "when": "view == ideagittool.worktrees",
        "group": "navigation@4"
      }
    ],
    "view/item/context": [
      {
        "command": "ideagittool.worktrees.open",
        "when": "view == ideagittool.worktrees && viewItem =~ /^worktree/",
        "group": "1_open@1"
      },
      {
        "command": "ideagittool.worktrees.lock",
        "when": "view == ideagittool.worktrees && viewItem =~ / linked / && viewItem =~ / unlocked/",
        "group": "1_open@2"
      },
      {
        "command": "ideagittool.worktrees.unlock",
        "when": "view == ideagittool.worktrees && viewItem =~ / locked/",
        "group": "1_open@2"
      },
      {
        "command": "ideagittool.worktrees.delete",
        "when": "view == ideagittool.worktrees && viewItem =~ / linked /",
        "group": "2_delete@1"
      }
    ]
  },
  "keybindings": [
    {
      "command": "ideagittool.push",
      "key": "ctrl+shift+k",
      "mac": "cmd+shift+k",
      "when": "config.ideagittool.intellijShortcuts && !editorTextFocus"
    },
    {
      "command": "ideagittool.push",
      "key": "ctrl+shift+k",
      "mac": "cmd+shift+k",
      "when": "config.ideagittool.intellijShortcuts && editorTextFocus && config.ideagittool.intellijShortcutsInEditor"
    },
    {
      "command": "ideagittool.updateProject",
      "key": "ctrl+t",
      "mac": "cmd+t",
      "when": "config.ideagittool.intellijShortcuts"
    },
    {
      "command": "ideagittool.branches",
      "key": "ctrl+shift+`",
      "mac": "cmd+shift+`",
      "when": "config.ideagittool.intellijShortcuts"
    },
    {
      "command": "ideagittool.vcsOperationsPopup",
      "key": "alt+`",
      "mac": "ctrl+v",
      "when": "config.ideagittool.intellijShortcuts && !terminalFocus && !editorTextFocus"
    },
    {
      "command": "ideagittool.createBranch",
      "key": "ctrl+alt+n",
      "mac": "alt+cmd+n",
      "when": "config.ideagittool.intellijShortcuts && ideagittool.hasRepository"
    }
  ],
  "configuration": {
    "title": "IdeaGitTool",
    "properties": {
      "ideagittool.intellijShortcuts": {
        "type": "boolean",
        "default": true,
        "description": "Use IntelliJ keyboard shortcuts for Git actions (Ctrl+T Update Project, Ctrl+Shift+K Push, Ctrl+Shift+` Branches, Alt+` VCS Operations Popup, Ctrl+Alt+N New Branch)."
      },
      "ideagittool.intellijShortcutsInEditor": {
        "type": "boolean",
        "default": false,
        "description": "Also use Ctrl+Shift+K for Push while a text editor has focus (it replaces VS Code's Delete Line)."
      },
      "ideagittool.updateMethod": {
        "type": "string",
        "enum": [
          "merge",
          "rebase",
          "branchDefault"
        ],
        "enumDescriptions": [
          "Merge incoming changes into the current branch",
          "Rebase the current branch on top of incoming changes",
          "Branch Default (git config branch.<name>.rebase / pull.rebase)"
        ],
        "default": "merge",
        "description": "Update method used by Update Project."
      },
      "ideagittool.update.showDialog": {
        "type": "boolean",
        "default": true,
        "description": "Show the Update Project dialog before updating."
      },
      "ideagittool.update.saveChangesPolicy": {
        "type": "string",
        "enum": [
          "stash",
          "shelve"
        ],
        "default": "stash",
        "enumDescriptions": [
          "Using Stash",
          "Using Shelve"
        ],
        "description": "Clean working tree using: Stash / Shelve. Local changes are saved before Update Project, Smart Checkout and Smart Merge, and restored afterwards."
      },
      "ideagittool.push.tags": {
        "type": "string",
        "enum": [
          "none",
          "all",
          "current"
        ],
        "default": "none",
        "description": "Push tags option of the Push dialog."
      },
      "ideagittool.push.runHooks": {
        "type": "boolean",
        "default": true,
        "description": "Run Git hooks on push."
      },
      "ideagittool.push.autoUpdateOnRejected": {
        "type": "string",
        "enum": [
          "",
          "merge",
          "rebase"
        ],
        "default": "",
        "description": "Update method to use silently when a push is rejected. Empty: ask with the Push Rejected dialog."
      },
      "ideagittool.fetch.prune": {
        "type": "boolean",
        "default": false,
        "description": "Prune obsolete remote references on fetch."
      },
      "ideagittool.branches.showRecent": {
        "type": "boolean",
        "default": true,
        "description": "Show recent branches in the Branches tab."
      },
      "ideagittool.branches.showTags": {
        "type": "boolean",
        "default": true,
        "description": "Show tags in the Branches tab."
      },
      "ideagittool.branches.groupByDirectory": {
        "type": "boolean",
        "default": true,
        "description": "Branches tab: group branches by directory (\"feature/x\" under a \"feature\" folder)."
      },
      "ideagittool.branches.groupByRepository": {
        "type": "boolean",
        "default": true,
        "description": "Branches tab: group branches by repository when the workspace has several repositories."
      },
      "ideagittool.branches.searchActions": {
        "type": "boolean",
        "default": true,
        "description": "Branches tab: include actions (Update Project…, Commit…, …) in the search results."
      },
      "ideagittool.branches.syncControl": {
        "type": "boolean",
        "default": true,
        "description": "Execute branch operations on all roots: with several repositories, branches that exist in all of them are shown once in the Branches tab and their actions run in every repository."
      }
    }
  },
  "views": {
    "ideagittool-panel": [
      {
        "id": "ideagittool.worktrees",
        "name": "Worktrees",
        "when": "ideagittool.hasRepository"
