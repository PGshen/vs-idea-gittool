{
  "configuration": {
    "properties": {
      "ideagittool.localHistory.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Record Local History: file saves, creations, deletions, renames and external changes (git operations)."
      },
      "ideagittool.localHistory.retentionDays": {
        "type": "number",
        "default": 5,
        "minimum": 1,
        "description": "Keep Local History for this number of days (IntelliJ: \"Keep local history for N working days\")."
      }
    }
  },
  "commands": [
    { "command": "ideagittool.localHistory.showHistory", "title": "Show History…", "category": "IdeaGitTool: Local History", "icon": "$(history)" },
    { "command": "ideagittool.localHistory.showSelectionHistory", "title": "Show History for Selection…", "category": "IdeaGitTool: Local History" },
    { "command": "ideagittool.localHistory.showProjectHistory", "title": "Show Project History…", "category": "IdeaGitTool: Local History" },
    { "command": "ideagittool.localHistory.recentChanges", "title": "Recent Changes", "category": "IdeaGitTool: Local History" },
    { "command": "ideagittool.localHistory.putLabel", "title": "Put Label…", "category": "IdeaGitTool: Local History" },
    { "command": "ideagittool.localHistory.putSystemLabel", "title": "Put System Label", "category": "IdeaGitTool: Local History" },
    { "command": "ideagittool.rollbackFile", "title": "Rollback File…", "category": "IdeaGitTool" },
    { "command": "ideagittool.removeFromVcs", "title": "Remove from VCS", "category": "IdeaGitTool" },
    { "command": "ideagittool.revertResolved", "title": "Revert Resolved", "category": "IdeaGitTool" },
    { "command": "ideagittool.createPatchFromChanges", "title": "Create Patch from Local Changes…", "category": "IdeaGitTool" },
    { "command": "ideagittool.unshelveSilently", "title": "Unshelve Silently", "category": "IdeaGitTool" },
    { "command": "ideagittool.copyPath", "title": "Copy Path", "category": "IdeaGitTool" },
    { "command": "ideagittool.noop", "title": "No Operation", "category": "IdeaGitTool" },
    { "command": "ideagittool.copyPath.absolute", "title": "Absolute Path" },
    { "command": "ideagittool.copyPath.name", "title": "File Name" },
    { "command": "ideagittool.copyPath.lineNumber", "title": "Path with Line Number" },
    { "command": "ideagittool.copyPath.contentRoot", "title": "Path from Content Root" },
    { "command": "ideagittool.copyPath.repo", "title": "Path From Repository Root" },
    { "command": "ideagittool.copyPath.reference", "title": "Copy Reference" }
  ],
  "submenus": [
    { "id": "ideagittool.localHistory", "label": "Local History" },
    { "id": "ideagittool.copyReference", "label": "Copy Path/Reference…" }
  ],
  "menus": {
    "ideagittool.localHistory": [
      { "command": "ideagittool.localHistory.showHistory", "group": "1_show@1" },
      { "command": "ideagittool.localHistory.showSelectionHistory", "group": "1_show@2", "when": "editorTextFocus || editorHasSelection" },
      { "command": "ideagittool.localHistory.showProjectHistory", "group": "2_project@1" },
      { "command": "ideagittool.localHistory.recentChanges", "group": "2_project@2" },
      { "command": "ideagittool.localHistory.putLabel", "group": "2_project@3" }
    ],
    "ideagittool.copyReference": [
      { "command": "ideagittool.copyPath.absolute", "group": "1_file@1" },
      { "command": "ideagittool.copyPath.name", "group": "1_file@2" },
      { "command": "ideagittool.copyPath.lineNumber", "group": "2_path@1", "when": "editorTextFocus" },
      { "command": "ideagittool.copyPath.contentRoot", "group": "2_path@2" },
      { "command": "ideagittool.copyPath.repo", "group": "2_path@3", "when": "ideagittool.hasRepository" },
      { "command": "ideagittool.copyPath.reference", "group": "3_reference@1" }
    ],
    "ideagittool.git.file": [
      { "command": "ideagittool.rollbackFile", "group": "3_rollback@2" },
      { "command": "ideagittool.revertResolved", "group": "4_conflicts@2", "when": "ideagittool.inOperation" }
    ],
    "explorer/context": [
      { "submenu": "ideagittool.localHistory", "group": "7_modification@8", "when": "workspaceFolderCount > 0" }
    ],
    "editor/context": [
      { "submenu": "ideagittool.localHistory", "group": "1_modification@8", "when": "resourceScheme == file" },
      { "submenu": "ideagittool.copyReference", "group": "9_cutcopypaste@9", "when": "resourceScheme == file" }
    ],
    "editor/title/context": [
      { "submenu": "ideagittool.localHistory", "group": "2_files@8", "when": "resourceScheme == file" },
      { "submenu": "ideagittool.copyReference", "group": "1_copypath@9", "when": "resourceScheme == file" }
    ],
    "commandPalette": [
      { "command": "ideagittool.localHistory.putSystemLabel", "when": "false" },
      { "command": "ideagittool.noop", "when": "false" },
      { "command": "ideagittool.copyPath", "when": "false" },
      { "command": "ideagittool.copyPath.absolute", "when": "false" },
      { "command": "ideagittool.copyPath.name", "when": "false" },
      { "command": "ideagittool.copyPath.lineNumber", "when": "false" },
      { "command": "ideagittool.copyPath.contentRoot", "when": "false" },
      { "command": "ideagittool.copyPath.repo", "when": "false" },
      { "command": "ideagittool.copyPath.reference", "when": "false" },
      { "command": "ideagittool.revertResolved", "when": "ideagittool.inOperation" }
    ]
  },
  "keybindings": [
    { "command": "ideagittool.noop", "key": "ctrl+shift+h", "mac": "cmd+shift+h", "when": "focusedView == ideagittool.commit" },
    { "command": "ideagittool.noop", "key": "ctrl+alt+a", "mac": "alt+cmd+a", "when": "focusedView == ideagittool.commit" },
    { "command": "ideagittool.localHistory.recentChanges", "key": "alt+shift+c", "when": "config.ideagittool.intellijShortcuts && !filesExplorerFocus" },
    { "command": "ideagittool.copyPath.reference", "key": "ctrl+alt+shift+c", "mac": "alt+shift+cmd+c", "when": "config.ideagittool.intellijShortcuts && editorTextFocus" }
  ]
}
