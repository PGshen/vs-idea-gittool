      },
      {
        "command": "rebased.commitAndPush",
        "key": "ctrl+alt+k",
        "mac": "alt+cmd+k",
        "when": "config.rebased.intellijShortcuts"
      },
      {
        "command": "rebased.rollback",
        "key": "ctrl+alt+z",
        "mac": "alt+cmd+z",
        "when": "config.rebased.intellijShortcuts && !editorTextFocus"
      },
      {
        "command": "rebased.unshelve",
        "key": "ctrl+shift+u",
        "when": "focusedView == rebased.commit"
      },
      {
        "command": "rebased.showLog",
        "key": "alt+9",
        "mac": "cmd+9",
        "when": "rebased.hasRepository"
      },
      {
        "command": "rebased.annotate",
        "key": "ctrl+alt+shift+a",
        "when": "editorTextFocus && rebased.hasRepository && !rebased.annotated"
      },
      {
        "command": "rebased.annotateClose",
        "key": "ctrl+alt+shift+a",
        "when": "editorTextFocus && rebased.annotated"
      },
      {
        "command": "rebased.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "config.rebased.intellijShortcuts && !editorTextFocus"
      },
      {
        "command": "rebased.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "config.rebased.intellijShortcuts && editorTextFocus && config.rebased.intellijShortcutsInEditor"
      },
      {
        "command": "rebased.updateProject",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "config.rebased.intellijShortcuts"
      },
      {
        "command": "rebased.branches",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`",
        "when": "config.rebased.intellijShortcuts"
      },
      {
        "command": "rebased.vcsOperationsPopup",
        "key": "alt+`",
        "mac": "ctrl+v",
        "when": "config.rebased.intellijShortcuts && !terminalFocus && !editorTextFocus"
      },
      {
        "command": "rebased.createBranch",
        "key": "ctrl+alt+n",
        "mac": "alt+cmd+n",
        "when": "config.rebased.intellijShortcuts && rebased.hasRepository"
      }
