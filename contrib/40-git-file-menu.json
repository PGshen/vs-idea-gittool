{
  "submenus": [
    {
      "id": "rebased.git.file",
      "label": "Git"
    }
  ],
  "menus": {
    "rebased.git.file": [
      {
        "command": "rebased.commit",
        "group": "1_file@1"
      },
      {
        "command": "rebased.addToVcs",
        "group": "1_file@2"
      },
      {
        "command": "rebased.addToGitignore",
        "group": "1_file@3"
      },
      {
        "command": "rebased.annotate",
        "group": "2_history@1",
        "when": "!rebased.annotated"
      },
      {
        "command": "rebased.annotateClose",
        "group": "2_history@2",
        "when": "rebased.annotated"
      },
      {
        "command": "rebased.showLocalDiff",
        "group": "2_history@3"
      },
      {
        "command": "rebased.compareWithRevision",
        "group": "2_history@4"
      },
      {
        "command": "rebased.compareWithBranch",
        "group": "2_history@5"
      },
      {
        "command": "rebased.showFileHistory",
        "group": "2_history@6"
      },
      {
        "command": "rebased.showHistoryForSelection",
        "group": "2_history@7",
        "when": "editorHasSelection"
      },
      {
        "command": "rebased.rollback",
        "group": "3_rollback@1"
      },
      {
        "command": "rebased.shelve",
        "group": "3_rollback@3"
      },
      {
        "command": "rebased.resolveConflicts",
        "group": "4_conflicts@1",
        "when": "rebased.hasConflicts"
      }
    ],
    "explorer/context": [
      {
        "submenu": "rebased.git.file",
        "group": "7_modification@9",
        "when": "rebased.hasRepository"
      }
    ],
    "editor/context": [
      {
        "submenu": "rebased.git.file",
        "group": "1_modification@9",
        "when": "rebased.hasRepository && resourceScheme == file"
      }
    ],
    "editor/title/context": [
      {
        "submenu": "rebased.git.file",
        "group": "2_files@9",
        "when": "rebased.hasRepository && resourceScheme == file"
      }
    ]
  }
}
