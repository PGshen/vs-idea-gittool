{
  "name": "rebased-vscode",
  "displayName": "Rebased Git Client",
  "description": "The Rebased / IntelliJ git client, remade as a VS Code extension: git log with graph, commit tool window, shelf, branches popup, interactive rebase, push/update dialogs, conflicts resolver and annotations.",
  "version": "0.1.0",
  "publisher": "rebased-vscode",
  "license": "Apache-2.0",
  "icon": "media/rebased.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "log",
    "graph",
    "intellij",
    "rebase",
    "shelf",
    "rebased"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "scripts": {
    "contrib": "node scripts/merge-contrib.mjs",
    "build": "npm run contrib && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "test": "node scripts/test.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "contributes": {
    "configuration": {
      "title": "Rebased",
      "properties": {
        "rebased.gitPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Git executable. Leave empty to use git from PATH."
        },
        "rebased.appearance": {
          "type": "string",
          "enum": [
            "intellij",
            "vscode"
          ],
          "enumDescriptions": [
            "Use the IntelliJ New UI light/dark palette (picked by the VS Code theme kind).",
            "Keep the IntelliJ layout and icons but use the colors of the current VS Code theme."
          ],
          "default": "intellij",
          "description": "Color palette of the Rebased views and dialogs."
        },
        "rebased.untrackedFiles": {
          "type": "string",
          "enum": [
            "all",
            "normal",
            "hide"
          ],
          "default": "all",
          "description": "How to show unversioned files in the Commit view."
        },
        "rebased.showIgnoredFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show ignored files in the Commit view."
        },
        "rebased.repositoryScanMaxDepth": {
          "type": "number",
          "default": 1,
          "description": "How deep to look for nested Git repositories below each workspace folder."
        },
        "rebased.fileStatusColors": {
          "type": "boolean",
          "default": true,
          "description": "Color file names in the Explorer and editor tabs by their Git status, like IntelliJ."
        },
        "rebased.commit.gpgSign": {
          "type": "boolean",
          "default": false,
          "description": "Sign commits with GPG key (git commit -S). Like IntelliJ, this is a setting, not a commit option."
        },
        "rebased.commit.includeActiveChangelist": {
          "type": "boolean",
          "default": false,
          "description": "Include new changes of the active changelist into the commit automatically (check them in the Commit tool window)."
        },
        "rebased.commit.skipHooks": {
          "type": "boolean",
          "default": false,
          "description": "Do not run Git commit hooks (commit always runs with '--no-verify')."
        },
        "rebased.intellijShortcuts": {
          "type": "boolean",
          "default": true,
          "description": "Use IntelliJ keyboard shortcuts for Git actions (Ctrl+T Update Project, Ctrl+Shift+K Push, Ctrl+Shift+` Branches, Alt+` VCS Operations Popup, Ctrl+Alt+N New Branch)."
        },
        "rebased.log.showInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show the log in the editor window (Rebased default). When off, the log is shown in the \"Git\" panel at the bottom, like in JetBrains IDEs."
        },
        "rebased.log.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the Git log when a workspace with a Git repository is opened."
        },
        "rebased.annotate.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Annotate with Git Blame: show the author."
        },
        "rebased.annotate.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Annotate with Git Blame: show the date."
        },
        "rebased.annotate.showRevision": {
          "type": "boolean",
          "default": false,
          "description": "Annotate with Git Blame: show the revision."
        },
        "rebased.annotate.preferCommitDate": {
          "type": "boolean",
          "default": false,
          "description": "Annotate with Git Blame: show the commit timestamp instead of the author timestamp."
        },
        "rebased.annotate.names": {
          "type": "string",
          "enum": [
            "full",
            "first",
            "last",
            "initials",
            "email"
          ],
          "default": "first",
          "description": "Annotate with Git Blame: how to show author names."
        },
        "rebased.annotate.colors": {
          "type": "string",
          "enum": [
            "order",
            "author",
            "hide"
          ],
          "default": "order",
          "description": "Annotate with Git Blame: background colors by commit order (age), by author, or none."
        },
        "rebased.annotate.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Annotate with Git Blame: ignore whitespace changes (-w)."
        },
        "rebased.annotate.detectMovementsWithinFile": {
          "type": "boolean",
          "default": false,
          "description": "Annotate with Git Blame: detect moved lines within the file (-M)."
        },
        "rebased.annotate.detectMovementsAcrossFiles": {
          "type": "boolean",
          "default": false,
          "description": "Annotate with Git Blame: detect lines moved from other files (-C)."
        },
        "rebased.intellijShortcutsInEditor": {
          "type": "boolean",
          "default": false,
          "description": "Also use Ctrl+Shift+K for Push while a text editor has focus (it replaces VS Code's Delete Line)."
        },
        "rebased.updateMethod": {
          "type": "string",
          "enum": [
            "merge",
            "rebase",
            "branchDefault"
          ],
          "enumDescriptions": [
            "Merge incoming changes into the current branch",
            "Rebase the current branch on top of incoming changes",
            "Branch Default (git config branch.<name>.rebase / pull.rebase)"
          ],
          "default": "merge",
          "description": "Update method used by Update Project."
        },
        "rebased.update.showDialog": {
          "type": "boolean",
          "default": true,
          "description": "Show the Update Project dialog before updating."
        },
        "rebased.update.saveChangesPolicy": {
          "type": "string",
          "enum": [
            "stash",
            "shelve"
          ],
          "default": "stash",
          "enumDescriptions": [
            "Using Stash",
            "Using Shelve"
          ],
          "description": "Clean working tree using: Stash / Shelve. Local changes are saved before Update Project, Smart Checkout and Smart Merge, and restored afterwards."
        },
        "rebased.push.tags": {
          "type": "string",
          "enum": [
            "none",
            "all",
            "current"
          ],
          "default": "none",
          "description": "Push tags option of the Push dialog."
        },
        "rebased.push.runHooks": {
          "type": "boolean",
          "default": true,
          "description": "Run Git hooks on push."
        },
        "rebased.push.autoUpdateOnRejected": {
          "type": "string",
          "enum": [
            "",
            "merge",
            "rebase"
          ],
          "default": "",
          "description": "Update method to use silently when a push is rejected. Empty: ask with the Push Rejected dialog."
        },
        "rebased.fetch.prune": {
          "type": "boolean",
          "default": false,
          "description": "Prune obsolete remote references on fetch."
        },
        "rebased.branches.showRecent": {
          "type": "boolean",
          "default": true,
          "description": "Show recent branches in the branches popup."
        },
        "rebased.branches.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show tags in the branches popup."
        },
        "rebased.branches.syncControl": {
          "type": "boolean",
          "default": true,
          "description": "Execute branch operations on all roots: with several repositories, branches that exist in all of them are shown once in the branches popup and their actions run in every repository."
        },
        "rebased.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Git toolbar widgets (Update Project, Push, branch, merge/rebase actions) in the status bar."
        }
      }
    },
