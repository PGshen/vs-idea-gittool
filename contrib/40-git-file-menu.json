{
  "submenus": [
    {
      "id": "ideagittool.git.file",
      "label": "Git"
    }
  ],
  "menus": {
    "ideagittool.git.file": [
      {
        "command": "ideagittool.commit",
        "group": "1_file@1"
      },
      {
        "command": "ideagittool.addToVcs",
        "group": "1_file@2"
      },
      {
        "command": "ideagittool.addToGitignore",
        "group": "1_file@3"
      },
      {
        "command": "ideagittool.annotate",
        "group": "2_history@1",
        "when": "!ideagittool.annotated"
      },
      {
        "command": "ideagittool.annotateClose",
        "group": "2_history@2",
        "when": "ideagittool.annotated"
      },
      {
        "command": "ideagittool.showLocalDiff",
        "group": "2_history@3"
      },
      {
        "command": "ideagittool.compareWithRevision",
        "group": "2_history@4"
      },
      {
        "command": "ideagittool.compareWithBranch",
        "group": "2_history@5"
      },
      {
        "command": "ideagittool.showFileHistory",
        "group": "2_history@6"
      },
      {
        "command": "ideagittool.showHistoryForSelection",
        "group": "2_history@7",
        "when": "editorHasSelection"
      },
      {
        "command": "ideagittool.rollback",
        "group": "3_rollback@1"
      },
      {
        "command": "ideagittool.shelve",
        "group": "3_rollback@3"
      },
      {
        "command": "ideagittool.resolveConflicts",
        "group": "4_conflicts@1",
        "when": "ideagittool.hasConflicts"
      }
    ],
    "explorer/context": [
      {
        "submenu": "ideagittool.git.file",
        "group": "7_modification@9",
        "when": "ideagittool.hasRepository"
      }
    ],
    "editor/context": [
      {
        "submenu": "ideagittool.git.file",
        "group": "1_modification@9",
        "when": "ideagittool.hasRepository && resourceScheme == file"
      }
    ],
    "editor/title/context": [
      {
        "submenu": "ideagittool.git.file",
        "group": "2_files@9",
        "when": "ideagittool.hasRepository && resourceScheme == file"
      }
    ]
  }
}
