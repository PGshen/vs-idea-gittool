          "when": "rebased.hasRepository"
        },
        {
          "command": "rebased.applyPatchFromClipboard",
          "when": "rebased.hasRepository"
        },
        {
          "command": "rebased.abortOperation",
          "when": "rebased.operation && rebased.operation != 'none'"
        },
        {
          "command": "rebased.continueOperation",
          "when": "rebased.operation && rebased.operation != 'none'"
        },
        {
          "command": "rebased.skipCommit",
          "when": "rebased.operation && rebased.operation != 'none'"
        }
      ]
